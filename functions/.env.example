# Biteo Vendor Panel — Cloud Functions environment template
#
# This file is a DOCUMENTATION/TEMPLATE ONLY. It is NOT automatically loaded
# by the application and contains NO real credentials.
#
# Copy this file to `functions/.env` ONLY on the machine that runs or deploys
# Cloud Functions, and fill in the real values from your Razorpay dashboard
# (Settings -> API Keys for the environment you intend to use).
#
# Real `functions/.env` files must NEVER be committed to the repository.
# The repository `.gitignore` excludes `.env`, `.env.*` and only keeps this
# example. If you believe credentials were ever exposed beyond your local
# machine, rotate them in the Razorpay dashboard before using them.
#
# In production, prefer Firebase Cloud Functions secret configuration
# (https://firebase.google.com/docs/functions/config-env) instead of a
# committed file.

RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET